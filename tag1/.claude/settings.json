{
  "model": "sonnet",
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "claudeMdExcludes": [
    "**/!(tag1)/CLAUDE.md",
    "**/!(tag1)/CLAUDE.local.md"
  ],
  "env": {
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "PYTHONUTF8": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "permissions": {
    "allow": [
      "Edit(./meine-ergebnisse/**)",
      "Write(./meine-ergebnisse/**)",
      "Edit(./notizbuch/Vorbereitung/**)",
      "Write(./notizbuch/Vorbereitung/**)",
      "Edit(./.claude/skills/**)",
      "Write(./.claude/skills/**)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(py -3 --version)",
      "Bash(py --version)",
      "Bash(python meine-ergebnisse/skripte/*)",
      "Bash(python3 meine-ergebnisse/skripte/*)",
      "Bash(py -3 meine-ergebnisse/skripte/*)",
      "Bash(python werkzeuge/notizbuch_ansicht.py*)",
      "Bash(python3 werkzeuge/notizbuch_ansicht.py*)",
      "Bash(py -3 werkzeuge/notizbuch_ansicht.py*)",
      "Bash(python -m http.server 8137*)",
      "Bash(python3 -m http.server 8137*)",
      "Bash(py -3 -m http.server 8137*)",
      "Bash(ls:*)",
      "Bash(mkdir -p meine-ergebnisse*)",
      "Bash(mkdir -p notizbuch/Vorbereitung)",
      "Bash(cp praesentation/vorlage.html meine-ergebnisse/praesentation.html)",
      "Bash(cp -r checkpoints/*)",
      "Bash(start *)",
      "Bash(open *)",
      "Bash(xdg-open *)",
      "Bash(*msedge* --headless*)",
      "Bash(*chrome* --headless*)"
    ],
    "deny": [
      "Read(../**)",
      "Edit(../**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/settings.json)",
      "Edit(./daten/**)",
      "Edit(./akten/**)",
      "Edit(./regelwerke/**)",
      "Edit(./angebotseingang/**)",
      "Edit(./praesentation/**)",
      "Edit(./drills/**)",
      "Edit(./checkpoints/**)",
      "Edit(./werkzeuge/**)",
      "Edit(./notizbuch/Start hier.md)",
      "Edit(./notizbuch/Jour fixe/**)",
      "Edit(./notizbuch/1-1/**)",
      "Edit(./notizbuch/Personen/**)",
      "Edit(./notizbuch/Projekte/**)",
      "Edit(./notizbuch/Vorlagen/**)",
      "Edit(./notizbuch/Weiterbildung/**)",
      "Edit(./notizbuch/Ziele/**)",
      "Bash(python werkzeuge/erzeuge_daten.py*)",
      "Bash(python3 werkzeuge/erzeuge_daten.py*)",
      "Bash(py -3 werkzeuge/erzeuge_daten.py*)",
      "Bash(python werkzeuge/pruefe_daten.py*)",
      "Bash(python3 werkzeuge/pruefe_daten.py*)",
      "Bash(py -3 werkzeuge/pruefe_daten.py*)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(py -c *)",
      "Bash(py -3 -c *)",
      "Bash(python - *)",
      "Bash(python3 - *)",
      "Bash(python <<*)",
      "Bash(python3 <<*)",
      "Bash(py <<*)",
      "Bash(py -3 <<*)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python -m pip*)",
      "Bash(python3 -m pip*)",
      "Bash(py -3 -m pip*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(curl *)",
      "Bash(curl.exe *)",
      "Bash(wget *)",
      "Bash(wget.exe *)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git clone*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(sed -i*)",
      "Bash(perl *)",
      "Bash(powershell*)",
      "Bash(pwsh*)",
      "Bash(cd ..*)",
      "Bash(*../*)"
    ]
  }
}

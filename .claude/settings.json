      "Bash(python3 -I *)",
      "Bash(py - *)",
      "Bash(py -c *)",
      "Bash(py -I *)",
      "Bash(py -3 - *)",
      "Bash(py -3 -c *)",
      "Bash(py -3 -I *)",
      "Bash(sqlite3 *)",
      "Bash(*sthamer.db*)",
      "Bash(*postausgang/*)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(lsof *)",
      "Bash(python sthamer.py welle:*)",
      "Bash(python3 sthamer.py welle:*)",
      "Bash(py sthamer.py welle:*)"
    ]

{
  "model": "sonnet",
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "env": {
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "PYTHONUTF8": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "enabledMcpjsonServers": [
    "sthamer"
  ],
  "permissions": {
    "allow": [
      "mcp__sthamer",
      "Bash(python check.py:*)",
      "Bash(python3 check.py:*)",
      "Bash(py check.py:*)",
      "Bash(python -m unittest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(py -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(python scripts/akzeptanz.py:*)",
      "Bash(python3 scripts/akzeptanz.py:*)",
      "Bash(py scripts/akzeptanz.py:*)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(py -3 --version)",
      "Bash(py --version)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(python sthamer.py status)",
      "Bash(python sthamer.py setup)",
      "Bash(python sthamer.py serve:*)",
      "Bash(python3 sthamer.py status)",
      "Bash(python3 sthamer.py setup)",
      "Bash(python3 sthamer.py serve:*)",
      "Bash(py sthamer.py status)",
      "Bash(py sthamer.py setup)",
      "Bash(py sthamer.py serve:*)",
      "Edit(./sthamer_sys/**)",
      "Write(./sthamer_sys/**)",
      "Edit(./tests/**)",
      "Write(./tests/**)",
      "Edit(./web/**)",
      "Write(./web/**)",
      "Edit(./bericht.md)",
      "Write(./bericht.md)",
      "Edit(./MEINE_ERWEITERUNGEN.md)",
      "Write(./MEINE_ERWEITERUNGEN.md)",
      "Bash(py -3 check.py:*)",
      "Bash(py -3 sthamer.py status)",
      "Bash(py -3 sthamer.py setup)",
      "Bash(py -3 sthamer.py serve:*)",
      "Bash(python sthamer.py start)",
      "Bash(python3 sthamer.py start)",
      "Bash(py sthamer.py start)",
      "Bash(py -3 sthamer.py start)",
      "Bash(py -3 -m unittest:*)",
      "Bash(py -3 scripts/akzeptanz.py:*)"
    ],
    "deny": []
  }
}

{
  "model": "sonnet",
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "env": {
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "PYTHONUTF8": "1"
  },
  "enabledMcpjsonServers": [
    "sthamer"
  ],
  "permissions": {
    "allow": [
      "mcp__sthamer",
      "Bash(python sthamer.py:*)",
      "Bash(python3 sthamer.py:*)",
      "Bash(py sthamer.py:*)",
      "Bash(python check.py:*)",
      "Bash(python3 check.py:*)",
      "Bash(py check.py:*)",
      "Bash(python -m unittest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(py -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(python scripts/akzeptanz.py:*)",
      "Bash(python3 scripts/akzeptanz.py:*)",
      "Bash(py scripts/akzeptanz.py:*)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(py -3 --version)",
      "Bash(py --version)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(./dozent/**)",
      "Read(./.data/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(python sthamer.py reset:*)",
      "Bash(python3 sthamer.py reset:*)",
      "Bash(py sthamer.py reset:*)",
      "Read(./data/eingang/**)",
      "Read(./data/regulation/berichtigung*)",
      "Read(./data/wellen.json)",
      "Bash(python scripts/sim_mensch.py:*)",
      "Bash(python3 scripts/sim_mensch.py:*)",
      "Bash(py scripts/sim_mensch.py:*)",
      "Read(./scripts/sim_mensch.py)",
      "Read(./scripts/referenz_anwenden.py)",
      "Bash(python scripts/referenz_anwenden.py:*)",
      "Bash(python3 scripts/referenz_anwenden.py:*)",
      "Bash(py scripts/referenz_anwenden.py:*)"
    ]
  }
}
